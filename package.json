{
  "name": "hermes",
  "version": "1.1.6",
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration local",
    "build": "ng build --configuration production",
    "build:ci": "ng build --configuration production && git add -A && git -c user.name='machineuser' -c user.email='<>' commit -m \"build project\"",
    "patch": "npm version patch",
    "publish-patch": "yarn build-commit && yarn patch && git push",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
  "dependencies": {
